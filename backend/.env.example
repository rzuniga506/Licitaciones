# Application Settings
APP_NAME="Sistema de Gestión de Licitaciones"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/licitaciones_db
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=licitaciones_db

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-password
SMTP_FROM=noreply@licitaciones.com
SMTP_FROM_NAME="Sistema de Licitaciones"

# File Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=[".pdf",".doc",".docx",".xls",".xlsx",".zip"]

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Alert System
ALERT_CHECK_INTERVAL=3600
DOCUMENT_EXPIRY_ALERT_DAYS=15
CONTRACT_END_ALERT_DAYS=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
